# KRAL Configuration

# Binance
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_REST_BASE=https://api.binance.com/api/v3

# BIST
BIST_API_KEY=your_key_here
BIST_API_SECRET=your_secret_here
BIST_BASE_URL=https://api.bist.com

# Voice
VOICE_ENGINE=pyttsx3
STT_ENGINE=speech_recognition
VOICE_RATE=150

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/kral.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Timeouts
REQUEST_TIMEOUT=30
WS_TIMEOUT=60
LISTEN_TIMEOUT=12

# Debug
DEBUG=false
DEMO_MODE=false
